# URL of the FastAPI backend (no trailing slash). Server-side only.
# For local dev: http://localhost:8000
# For production: http://your-ec2-ip:8000
BACKEND_URL=http://localhost:8000

# LiveKit WebSocket URL — get this from your LiveKit Cloud project dashboard
# e.g. wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
